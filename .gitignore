# Gradle wrapper jar is restored from gradle-wrapper.jar.b64 (see README).
gradle/wrapper/gradle-wrapper.jar

# Gradle / Android / Kotlin
.gradle/
.kotlin/
build/
local.properties
*.iml

# Android Studio
.idea/

# Keystores: release keys must NEVER be committed. The fixed DEBUG keystore
# below is the standard public android/android credential, committed
# deliberately so all CI builds share one signature (seamless updates).
*.jks
*.keystore
!debug.keystore

# Native build outputs
.whispersrc/
.cxx/

# E2E artifacts: words.json is derived from the user's private narration audio;
# keep it local unless the user explicitly wants it in the repo (the
# RealAudioE2ETest skips gracefully when it is absent).
e2e/words.json
e2e/out/
e2e/*.log
server/.venv/
server/__pycache__/
server/*.pyc

# OS
.DS_Store
Thumbs.db

# Local secrets — never commit
*.env
secrets.properties
